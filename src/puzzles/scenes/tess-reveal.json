    "start": {
      "lines": [
        {
          "text": "The center tank. The water is very still. Then it isn't."
        },
        {
          "who": "tess",
          "text": "Forty years I've watched this door. Forty years of tapping on my glass."
        },
        {
          "who": "bo",
          "text": "She's never talked before."
        },
        {
          "who": "tess",
          "text": "I've never had anything to say. Now I do: get out of my aquarium."
        },
        {
          "who": "rook",
          "text": "Technically it's Bo's aquarium."
        },
        {
          "who": "tess",
          "text": "Technically, I have eight arms."
        }
      ]
    }
  }
}
