      "lines": [
        {
          "text": "Chapter 5: Step Right Up. A flyer under the office door, smelling of sawdust."
        },
        {
          "who": "dee",
          "text": "A travelling carnival. The rides have been running at night, with nobody on them."
        },
        {
          "who": "rook",
          "text": "Free rides?"
        },
        {
          "who": "dee",
          "text": "The flyer says 'SEND HELP'. In very nice lettering."
        },
        {
          "who": "rook",
          "text": "Showmanship. I respect it."
        }
      ]
    }
  }
}
