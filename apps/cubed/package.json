{
  "name": "picross-3d",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "puzzles": "vite-node scripts/puzzles.ts",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@picross/block": "*",
    "@picross/play-block": "*",
    "@picross/shared": "*",
    "@picross/story": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.49",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
