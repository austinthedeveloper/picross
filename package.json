{
  "name": "picross-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm -w apps/picross run dev --",
    "dev:prod": "npm -w apps/picross run dev:prod --",
    "build": "npm -w apps/picross run build",
    "build:dev": "npm -w apps/picross run build:dev",
    "check:bundle": "sh scripts/check-prod-bundle.sh",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "npm -w apps/picross run preview --",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm -w packages/shared test && npm -w packages/story test && npm -w packages/grid test && npm -w packages/play-grid test && npm -w packages/block test && npm -w packages/play-block test && npm -w apps/picross test",
    "test:watch": "npm -w apps/picross run test:watch --",
    "check:puzzles": "npm -w packages/grid run check:puzzles --",
    "script-review": "npm -w apps/picross run script-review --",
    "script-review:notes": "npm -w apps/picross run script-review:notes --",
    "script-review:export": "npm -w apps/picross run script-review:export --",
    "rate:puzzles": "npm -w apps/picross run rate:puzzles --",
    "e2e": "npm -w apps/picross run e2e --",
    "e2e:cubed": "npm -w apps/picross run e2e -- --project=cubed",
    "test:flat": "npm -w apps/picross test --",
    "test:shared": "npm -w packages/shared test --",
    "test:story": "npm -w packages/story test --",
    "test:grid": "npm -w packages/grid test --",
    "test:play-grid": "npm -w packages/play-grid test --",
    "test:block": "npm -w packages/block test --",
    "test:play-block": "npm -w packages/play-block test --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.49",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
