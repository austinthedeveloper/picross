{
  "name": "picross",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development --outDir dist-dev",
    "check:bundle": "sh scripts/check-prod-bundle.sh",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:puzzles": "vitest run src/puzzles/pack.test.ts",
    "script-review": "vite-node scripts/script-review.ts serve",
    "script-review:notes": "vite-node scripts/script-review.ts notes",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.49",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
