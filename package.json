{
  "name": "picross",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "tsc --noEmit && vite build && node scripts/build-cubed.mjs dist",
    "build:dev": "tsc --noEmit && vite build --mode development --outDir dist-dev && node scripts/build-cubed.mjs dist-dev",
    "check:bundle": "sh scripts/check-prod-bundle.sh",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run && npm -w cubed test",
    "test:watch": "vitest",
    "check:puzzles": "vitest run src/puzzles/pack.test.ts",
    "script-review": "vite-node scripts/script-review.ts serve",
    "script-review:notes": "vite-node scripts/script-review.ts notes",
    "script-review:export": "vite-node scripts/script-review.ts export",
    "rate:puzzles": "vite-node scripts/rate-puzzles.ts",
    "e2e": "playwright test",
    "dev:cubed": "npm -w cubed run dev",
    "test:flat": "vitest run",
    "test:cubed": "npm -w cubed test",
    "e2e:cubed": "npm -w cubed run e2e",
    "check:cubed": "npm -w cubed run check:shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.49",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "cubed"
  ]
}
